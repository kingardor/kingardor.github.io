// Cloudflare Workers deployment: static site (dist/) + Veronica API (worker/).
// Build with `npm run build` (+ `npm run prerender` in CI), deploy with
// `npm run deploy`. Secrets: `npx wrangler secret put OPENROUTER_API_KEY`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akash-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Hash routes (/#/chat) never reach the server, but deep links like
    // /chat or stale paths should still land on the app shell.
    "not_found_handling": "single-page-application",
    // /media/* is worker-first so the Worker can answer byte-range (206)
    // requests for video — static assets alone return full 200s.
    "run_worker_first": ["/api/*", "/media/*"]
  },
  // Keep the workers.dev URL alive alongside the custom domains — wrangler
  // otherwise disables it as soon as routes are configured.
  "workers_dev": true,
  "preview_urls": false,
  // akashjames.com zone lives on Cloudflare (same account as copcars.in).
  // NOTE: the deploy token needs Zone › Workers Routes › Edit on this zone
  // (wrangler lists zone routes to reconcile custom domains).
  "routes": [
    { "pattern": "akashjames.com", "custom_domain": true },
    { "pattern": "www.akashjames.com", "custom_domain": true }
  ],
  "vars": {
    "YT_CHANNEL_ID": "UCgJZkbxrBpbuHv4jOFuR8zQ",
    "YT_MAX": "9",
    "MODEL": "nvidia/nemotron-3-nano-30b-a3b",
    "TEMPERATURE": "0.6"
  },
  // Per-IP budget for /api/chat (per Cloudflare location; approximate by design).
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "2096", "simple": { "limit": 12, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
